<% month = calendar_month %>
<% users_by_day = calendar_users_by_day(happy_things, user_ids, month) %>

<div id="calendar" class="mx-2 my-3">
  <%# start_date: the checked month, so a broken date in the URL can't crash the calendar %>
  <%= month_calendar(start_date: month) do |date| %>
    <% if date.month == month.month %>
      <% users = users_by_day.fetch(date, []) %>
      <%= link_to happy_things_by_date_path(date: date.iso8601), class: 'calendar-day',
                                                                 aria: { label: calendar_day_label(date, users) } do %>
        <span class="calendar-day__number"><%= date.day %></span>
        <%# The pill only shows who; the link's aria-label already says how many people %>
        <% if users.any? %>
          <%= tag.span class: ['calendar-day__pill', { 'calendar-day__pill--full': users.size >= CalendarHelper::MAX_CALENDAR_EMOJIS }],
                       aria: { hidden: true } do %>
            <% users.first(CalendarHelper::MAX_CALENDAR_EMOJIS).each do |user| %>
              <span><%= user.emoji %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <span class="calendar-day calendar-day--other-month">
        <span class="calendar-day__number"><%= date.day %></span>
      </span>
    <% end %>
  <% end %>
</div>
