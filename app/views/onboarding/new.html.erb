<div class="homepage-container" data-controller="onboarding">

  <!-- Step 1: Welcome -->
  <div class="onboarding-step" data-onboarding-target="step1">
    <h2 class="onboarding-heading mb-4" data-onboarding-target="heading1"></h2>
    <p class="onboarding-text mb-4" data-onboarding-target="text1"></p>
    <div class="onboarding-input-container" data-onboarding-target="inputContainer1">
      <input type="text" 
             class="form-control mb-3" 
             placeholder=""
             data-onboarding-target="happyThing"
             data-action="keypress->onboarding#handleEnter">
      <button class="btn button--primary w-100" data-action="click->onboarding#nextStep">Next</button>
    </div>
  </div>

  <!-- Step 2: Emoji -->
  <div class="onboarding-step d-none" data-onboarding-target="step2">
    <h2 class="onboarding-heading mb-4" data-onboarding-target="heading2"></h2>
    <p class="onboarding-text mb-4" data-onboarding-target="text2"></p>
    <div class="onboarding-input-container" data-onboarding-target="inputContainer2">
      <div class="emoji-grid mb-3" data-onboarding-target="emojiGrid">
        <% %w[😊 😎 🥳 😴 🤗 🥰 😇 🤓 🤩 🥺 😌 🙃 😋 🤪 😸 🐶 🐱 🦊 🐼 🦄 🌟 ✨ 🌈 🎨 🌸 💫 🔥 💝 🎯 🎪].each do |emoji| %>
          <button class="emoji-option" data-emoji="<%= emoji %>" data-action="click->onboarding#selectEmojiAndAdvance"><%= emoji %></button>
        <% end %>
      </div>
      <input type="hidden" data-onboarding-target="emoji">
    </div>
  </div>

  <!-- Step 3: Name -->
  <div class="onboarding-step d-none" data-onboarding-target="step3">
    <h2 class="onboarding-heading mb-4" data-onboarding-target="heading3"></h2>
    <p class="onboarding-text mb-4" data-onboarding-target="text3"></p>
    <div class="onboarding-input-container" data-onboarding-target="inputContainer3">
      <input type="text" 
             class="form-control mb-3" 
             placeholder=""
             data-onboarding-target="firstName"
             data-action="keypress->onboarding#handleEnter">
      <button class="btn button--primary w-100" data-action="click->onboarding#showDashboard">Let's start!</button>
    </div>
  </div>
</div>
