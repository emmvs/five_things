<% if @happy_things_of_the_last_two_days.empty? %>
  <div class="mx-2 my-5">
    <p class="text-imprinted"><%= t('dashboard.nothing_to_see_yet') %></p>
  </div>
<% else %>
  <div class="dash-box mx-2 my-3">
    <h3><%= t('dashboard.what_made_you_happy') %></h3>
    <% @happy_things_of_the_last_two_days.each do |user, happy_things| %>
      <h5><%= user_with_emoji(user) %></h5>
      <% happy_things.each do |happy_thing| %>
        <%= render 'happy_things/happy_thing', happy_thing: happy_thing %>
      <% end %>
    <% end %>
  </div>
<% end %>
